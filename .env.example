# Backend LLM & Port Configuration
GEMINI_API_KEY=your_gemini_api_key_here
PORT=5000

# (Optional) Firebase Authentication Configuration
# If provided, SchedSim Lens will automatically use live Firebase Auth.
# If omitted or offline, SchedSim Lens uses built-in secure local simulated authentication.
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id